# D-Bus activation for the OneDrive hydration state service: the session bus
# starts the service the first time anything talks to the name, so a session
# with no tray (or flyout, or curious busctl) runs no state service at all.
# Activation is what the bus is for — the activating call is queued until the
# name appears, so the first caller sees a slow reply, never a missing one.
#
# SystemdService= hands the actual start to the systemd user manager, so the
# process lands in onedrive-hydration-dbus.service with that unit's restart
# policy and sandboxing instead of running as a bare child of the bus. Exec=
# stays as the fallback for a session bus running without systemd activation.
#
# Generated by onedrive-hydration-install for user @USER@ (uid @UID@).
[D-BUS Service]
Name=io.github.franzjeger.OneDriveHydration
Exec=@BIN@/onedrive-hydration-dbus --client-id @CLIENT_ID@
SystemdService=onedrive-hydration-dbus.service
