# Drive the privileged helper from the existence of its peer's socket.
#
# Generated by onedrive-hydration-install for user @USER@ (uid @UID@).
#
# The two halves cannot simply be ordered: the helper connects *out* to a socket
# the unprivileged daemon owns, in /run/user/@UID@, which does not exist until
# @USER@ logs in. A system service ordered After= anything would restart-loop
# every boot, and each attempt pulls the sync mount up via RequiresMountsFor=
# and then exits — leaving a mount full of placeholders with nothing to answer
# their reads.
#
# PathExists=, triggering the helper directly.
#
# Two things were tried here and are wrong. PathChanged= fires on every touch of
# the file, and a unix socket is touched by every connection, so the unit hit its
# own trigger limit within seconds and disabled itself. And triggering a oneshot
# that restarts the helper loops forever: a path unit re-arms the moment the unit
# it triggered finishes, the socket still exists, so it fires again immediately —
# and every restart is a window with the mount up and no helper answering, which
# is a window of zeros.
#
# So: start the helper, once, when the socket appears. Re-pairing after a client
# restart is not handled here; `systemctl restart hydrationd` is.
[Unit]
Description=Watch for the OneDrive sync daemon's socket
Documentation=https://github.com/franzjeger/OneDriveHydration

[Path]
PathExists=@SOCKET@
Unit=hydrationd.service
# Belt and braces after the above: a path unit that disables itself is a silent
# single point of failure, and this one has already done it once.
TriggerLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
