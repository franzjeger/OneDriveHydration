# The unprivileged OneDrive sync daemon: credentials, Graph access, sync logic.
#
# Generated by onedrive-hydration-install for user @USER@ (uid @UID@).
#
# A user unit, because this is the half that holds the credential — it reads the
# refresh token from the desktop's Secret Service, which only exists inside the
# user's session. The privileged helper never sees it, and that split is the
# whole design: the process that can be compromised is the one that cannot do
# damage. Losing this one is not dangerous; with nothing to fetch content,
# hydration fails with EIO, which is a correct answer.
[Unit]
Description=OneDrive hydration sync daemon (unprivileged)
Documentation=https://github.com/franzjeger/OneDriveHydration

# The sync root must be mounted before this starts, not after. The daemon
# creates placeholders without needing the helper — measured, 145,710 of them —
# so a daemon that started on the bare mountpoint would write them into the
# filesystem underneath the mount, where nothing can ever hydrate them.
RequiresMountsFor=@MOUNT_USER@

[Service]
Type=simple
# The client id is public configuration, not a secret — the code says so where
# it derives the keyring entry from it. The credential itself is in Secret
# Service and appears nowhere here.
ExecStart=@BIN@/onedrive-hydration-daemon run \
  --mount @MOUNT_USER@ \
  --state-dir %h/.local/state/onedrive-hydration \
  --client-id @CLIENT_ID@ \
  --socket @SOCKET_USER@
Restart=on-failure
RestartSec=5

# Deliberately NOT bound to the mount's lifetime. This half may come and go; the
# helper is the one that must not outlive its peer silently.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@MOUNT_USER@ %h/.local/state/onedrive-hydration
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
