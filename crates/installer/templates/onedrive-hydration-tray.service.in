# The tray icon: a StatusNotifierItem with a DBusMenu, spoken directly over
# zbus with no GUI toolkit — the panel draws everything. Driven by the state
# service's StateChanged signal; it never polls.
#
# Generated by onedrive-hydration-install for user @USER@ (uid @UID@).
#
# Icons resolve by name from the hicolor theme; run
# packaging/icons/install-icons.sh once per user, or the panel shows a
# missing-icon placeholder.
[Unit]
Description=OneDrive hydration tray icon
Documentation=https://github.com/franzjeger/OneDriveHydration
# A tray exists only inside a graphical session, and should go away with it.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=@BIN@/onedrive-hydration-tray --mount @MOUNT_USER@
# On a desktop with no org.kde.StatusNotifierWatcher the binary exits saying
# so. At login the watcher (plasmashell/kded6) may simply not be up yet, so a
# few spaced retries are correct — but on a desktop that will never have one,
# retrying forever is noise, so the limit below turns persistent absence into
# a visibly failed unit (~ten attempts) rather than an every-five-seconds
# respawn for the rest of the session. Once running, the binary re-registers
# by itself when the watcher restarts; the limit only governs startup.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=200
StartLimitBurst=10

NoNewPrivileges=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
