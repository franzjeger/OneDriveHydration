# The privileged hydration helper, for @USER@'s OneDrive sync root.
#
# Generated by onedrive-hydration-install for user @USER@ (uid @UID@), sync
# root @MOUNT@. Regenerate rather than edit. The shape follows the
# hand-written unit that was verified on a real deployment across a real
# reboot, not HydrationAPI's example — the example unit as written fails open
# on a single-user desktop, measured. Both differences are explained where
# they occur.
[Unit]
Description=Hydration helper for OneDrive (privileged)
Documentation=https://github.com/franzjeger/HydrationAPI

# RequiresMountsFor=, not BindsTo=. Measured upstream and recorded in
# deploy/README.md: with BindsTo= systemd reads the helper's own
# umount2(MNT_DETACH) on the way out as a deliberate stop and suppresses the
# restart entirely — both units inactive, permanently.
#
# The fstab entry this names is `noauto` on purpose. The mount must not exist
# before the process that marks it: a marked mount with no helper fails open and
# every placeholder in the subvolume becomes a source of zeros (the reference
# deployment held 145,710 of them).
RequiresMountsFor=@MOUNT@

# Started by hydrationd.path when the sync daemon's socket appears. The helper
# reconnects in-process across an ordinary client restart, re-checking the
# peer's uid on every connection. If the client stays gone past the helper's
# bounded recovery window, the helper detaches the mount and exits; the restart
# below then brings the mount back only after a peer can be reached again.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@BIN@/hydrationd --mount @MOUNT@ --socket @SOCKET@ --peer-uid @UID@
Restart=always
RestartSec=2

# ---------------------------------------------------------------------------
# NO MOUNT NAMESPACE. This is the load-bearing constraint of the whole file.
#
# `fanotify_mark(FAN_MARK_MOUNT)` marks the vfsmount in the *caller's* mount
# namespace. Give this unit a namespace of its own and it marks its private copy
# of the sync mount: the helper logs "watching @MOUNT@", the unit
# is active, and every read from the user's own session goes through an unmarked
# mount and returns zeros. Measured here — a 3,557-byte file read back 3,557
# zero bytes with all three units green.
#
# Measured, each of these alone puts the unit in its own mnt namespace:
#   PrivateTmp, ProtectKernelTunables, ProtectControlGroups,
#   ProtectKernelModules, PrivateNetwork
#
# HydrationAPI's example unit once set all five. None of them may be used
# here. That includes PrivateNetwork=yes — systemd mounts a private /sys for
# the network namespace, so it takes a mount namespace with it.
# RestrictAddressFamilies=AF_UNIX below denies the network at the syscall
# layer instead, which is the same guarantee for a process that only ever
# speaks to a unix socket, and costs no namespace. The installer that wrote
# this file scans the generated text and refuses to install any of these
# directives; hydrationd itself refuses to start inside a private namespace
# (selfcheck::reach). The mistake has to get past both to be silent.
# ---------------------------------------------------------------------------

User=root
# Both capabilities were measured, each added only after a failure demanded it:
#
#  * a 0700 home (the single-user default) makes `stat` on the sync root
#    return EACCES with CAP_SYS_ADMIN alone. The helper reports that as
#    "@MOUNT@ is not a directory" — `is_dir()` is
#    false for every stat error, so the symptom names the wrong cause.
#  * the sync daemon's socket is srw------- @USER@, and connecting to a unix
#    socket needs *write* permission, which CAP_DAC_READ_SEARCH does not give.
#
# CAP_DAC_OVERRIDE subsumes both, so this is one capability rather than two.
# The example unit's CAP_SYS_ADMIN-only set holds for a sync root anyone can
# traverse; it cannot hold for one inside a private home, which is where a
# single-user desktop always puts it.
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE

NoNewPrivileges=yes
# The network denial, done without a namespace. This process has no business
# reaching a network, and if it ever tries, that is the incident.
RestrictAddressFamilies=AF_UNIX
# Seccomp filters and personality bits — none of these create a namespace.
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# The supervisor exists to outlive the worker. Letting the kernel pick it as an
# OOM victim would remove the thing that makes failure safe, at exactly the
# moment things are going wrong.
OOMScoreAdjust=-900

# No [Install] section on purpose. Nothing should start this at boot: between
# boot and login there is no sync daemon to answer events, and a helper that
# starts anyway would pull the mount up and then exit, leaving the placeholders
# readable as zeros. hydrationd.path is the only trigger.
