# The session D-Bus state service: owns io.github.franzjeger.OneDriveHydration
# and mirrors the daemon's owner-only control socket, so a tray can subscribe
# to StateChanged instead of polling and never needs to know the socket exists.
#
# Generated by onedrive-hydration-install for user @USER@ (uid @UID@).
[Unit]
Description=OneDrive hydration D-Bus state service
Documentation=https://github.com/franzjeger/OneDriveHydration

[Service]
# Type=dbus: the unit counts as started when the name is acquired, which is
# the only readiness that means anything for a service whose entire surface is
# that name.
Type=dbus
BusName=io.github.franzjeger.OneDriveHydration
ExecStart=@BIN@/onedrive-hydration-dbus
# While the sync daemon is down this service keeps running and reports
# DaemonRunning=false, reconnecting on its own with bounded backoff — daemon
# absence is a reported state, not a failure. Restart= therefore only covers
# crashes. A second copy of the binary requests the name with DoNotQueue and
# exits non-zero rather than serving nothing; the default start rate limit (5
# in 10s) turns that into a visibly failed unit instead of a silent loop.
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
