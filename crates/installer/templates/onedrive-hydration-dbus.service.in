# The session D-Bus state service: owns io.github.franzjeger.OneDriveHydration
# and mirrors the daemon's owner-only control socket, so a tray can subscribe
# to StateChanged instead of polling and never needs to know the socket exists.
#
# Generated by onedrive-hydration-install for user @USER@ (uid @UID@).
[Unit]
Description=OneDrive hydration D-Bus state service
Documentation=https://github.com/franzjeger/OneDriveHydration

[Service]
# Type=dbus: the unit counts as started when the name is acquired, which is
# the only readiness that means anything for a service whose entire surface is
# that name.
Type=dbus
BusName=io.github.franzjeger.OneDriveHydration
ExecStart=@BIN@/onedrive-hydration-dbus --client-id @CLIENT_ID@
# While the sync daemon is down this service keeps running and reports
# DaemonRunning=false, reconnecting on its own with bounded backoff — daemon
# absence is a reported state, not a failure. Restart= therefore only covers
# crashes, and the default start rate limit (5 in 10s) turns a crash loop into
# a visibly failed unit instead of a silent one.
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
RestrictRealtime=yes
LockPersonality=yes

# No [Install] section, on purpose: this service is D-Bus-activated. The
# companion file the installer writes to ~/.local/share/dbus-1/services/
# names this unit in its SystemdService= line, so the bus asks the user
# manager to start it the first time anything talks to the name — the tray's
# initial cold property read, a busctl introspect, or the flyout. A
# session with no subscriber runs no state service at all, which is the
# point: an eagerly started copy would spend the whole session serving state
# to nobody, and the bus queues the activating call until the name appears,
# so even the first caller loses nothing. A hand start still works:
#   systemctl --user start onedrive-hydration-dbus.service
