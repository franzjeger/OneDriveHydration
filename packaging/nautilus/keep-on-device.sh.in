#!/bin/sh
# GNOME Files' "Keep on Device" script: pin the selection so eviction skips
# it, then pull its content down now. The inverse of "Free Up Space", and the
# Dolphin action's sibling — generated by install-nautilus-scripts.sh the
# same way, substituting the sync root and the control CLI's absolute path.
set -u

MOUNT='@MOUNT@'
CTL='@CTL@'
TITLE='OneDrive Hydration'
HYDRATE_BUSY_RETRIES=5

# A dead progress-dialog reader must read as "cancelled", not kill this
# script mid-sweep: writes to its pipe would otherwise raise SIGPIPE.
trap '' PIPE

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

human() {
    # iec-i, not iec: the daemon counts bytes, and `--to=iec` would render
    # 8192 as "8.0KB" — a decimal-looking label on a binary quantity.
    if command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec-i --suffix=B -- "$1"
    else
        printf '%s bytes' "$1"
    fi
}

files_word() {
    if [ "$1" -eq 1 ]; then printf 'file'; else printf 'files'; fi
}

# "item" not "file": a Keep on Device target can be a folder, and calling a
# pinned folder "1 file" is the confusing report this wording replaces.
items_word() {
    if [ "$1" -eq 1 ]; then printf 'item'; else printf 'items'; fi
}

# HydrationAPI is deliberately single-flight today. A second user action can
# therefore receive EIO while another file owns the fetch channel; the same
# file succeeds as soon as that request finishes. Retry only that measured
# transient, with a small bounded wait. Every other reply is returned
# verbatim immediately, so a real path, auth, or integrity failure is never
# hidden.
hydrate_with_busy_retry() {
    _target=$1
    _attempt=0
    while :; do
        _reply=$("$CTL" hydrate "$_target" 2>&1) || true
        case "$_reply" in
            "error: Input/output error (os error 5)")
                if [ "$_attempt" -lt "$HYDRATE_BUSY_RETRIES" ]; then
                    _attempt=$((_attempt + 1))
                    sleep 1
                    continue
                fi
                ;;
        esac
        printf '%s' "$_reply"
        return 0
    done
}

# A progress dialog for a folder pull — hundreds of files, and without it no
# sign anything is working. zenity --progress is GNOME's kdialog
# --progressbar, driven by lines on stdin instead of D-Bus: a percentage
# advances the bar, a "# text" line relabels it. The write end is a FIFO so
# the loop below can feed it without a bash-only process substitution;
# everything is guarded so the script still runs headless with every call a
# no-op. The dialog is advisory — closing it cancels the *pull*, never the
# pin that already happened.
progress_start() { # $1=total  $2=label
    prog_total=$1
    prog_dir=''
    prog_pid=''
    command -v zenity >/dev/null 2>&1 || return 0
    prog_dir=$(mktemp -d) || { prog_dir=''; return 0; }
    if ! mkfifo "$prog_dir/fifo" 2>/dev/null; then
        rm -rf "$prog_dir"
        prog_dir=''
        return 0
    fi
    zenity --progress --title "$TITLE" --text "$2" --percentage=0 --auto-close \
        <"$prog_dir/fifo" >/dev/null 2>&1 &
    prog_pid=$!
    # Opening a FIFO for write blocks until a reader exists; zenity just
    # opened the read end, so this is the handshake, not a hang.
    exec 9>"$prog_dir/fifo"
}

progress_set() { # $1=done  $2=label
    [ -n "${prog_dir:-}" ] || return 0
    printf '%s\n# %s\n' "$(($1 * 100 / prog_total))" "$2" >&9 2>/dev/null || true
}

progress_done() {
    [ -n "${prog_dir:-}" ] || return 0
    exec 9>&-
    rm -rf "$prog_dir"
    prog_dir=''
}

# True once the user closes or cancels the dialog — zenity exits either way,
# so a dead process is the one honest signal. Stopping leaves the folder
# pinned and whatever came down already resident — a valid state, and the
# summary reports exactly how many files were pulled before the stop.
progress_cancelled() {
    [ -n "${prog_pid:-}" ] || return 1
    ! kill -0 "$prog_pid" 2>/dev/null
}

# The download half of the result line: how many files came down, or that
# there was nothing to pull. Kept separate so "kept N on device" never
# implies a download that did not happen.
pull_summary() {
    if [ "$pulled_files" -gt 0 ]; then
        printf 'pulled %s %s down (%s)' "$pulled_files" "$(files_word "$pulled_files")" "$(human "$pulled")"
    else
        printf 'already on device'
    fi
}

# Nautilus runs scripts detached, so stdout is gone. Success is a passive
# notification; a refusal is modal, because the whole point of quoting the
# daemon verbatim is that somebody reads it. --no-markup because a daemon
# reply owes Pango nothing.
say() {
    urgency=$1
    body=$2
    if [ "$urgency" = ok ]; then
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -a "$TITLE" -i onedrive-hydration "$TITLE" "$body" >/dev/null 2>&1 && return 0
        fi
    else
        if command -v zenity >/dev/null 2>&1; then
            zenity --error --no-markup --title "$TITLE" --text "$body" >/dev/null 2>&1 && return 0
        fi
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -u critical -a "$TITLE" -i onedrive-hydration "$TITLE" "$body" >/dev/null 2>&1 && return 0
        fi
    fi
    printf '%s\n' "$body" >&2
}

[ "$#" -gt 0 ] || exit 0

kept=0          # items pinned (files and folders)
pulled=0        # bytes brought resident
pulled_files=0  # files whose content actually came down
problems=''

for f in "$@"; do
    # readlink -f normalises and resolves symlinks. It is a path operation
    # and reads no content — the deliberate read that hydrates the file
    # happens *inside* onedrive-hydrationctl, never in this shell. Nothing
    # below opens the target.
    abs=$(readlink -f -- "$f" 2>/dev/null) || abs=$f

    # A Nautilus script appears on every selection on the system, so the
    # containment lives here, exactly as it does for KIO.
    case "$abs" in
        "$MOUNT")
            problems="${problems}${abs}
    that is the sync folder itself, not a file in it
"
            continue
            ;;
        "$MOUNT"/*)
            rel=${abs#"$MOUNT"/}
            ;;
        *)
            problems="${problems}${abs}
    not inside the sync folder ($MOUNT) — nothing was done
"
            continue
            ;;
    esac

    # Pin first: it is the durable half, and the one that outlives a reboot
    # or a future eviction sweep. If the daemon refuses the pin, do not go on
    # to pull content down under a promise it would not keep.
    reply=$("$CTL" pin "$rel" 2>&1) || true
    case "$reply" in
        pinned)
            kept=$((kept + 1))
            ;;
        *)
            # Quoted verbatim, refusal and failure alike — the pin verb
            # answers `error: <why>` for a path it will not take.
            problems="${problems}${abs}
    ${reply}
"
            continue
            ;;
    esac

    # A directory is pinned as a single mark — it protects its whole subtree
    # — and its dehydrated files are pulled down one at a time. The daemon
    # lists them with its own judgment (confinement, and skipping the
    # framework's own names), and each is hydrated here; the reads stay
    # inside onedrive-hydrationctl, never in this shell. Fed by a here-doc
    # rather than a pipe, so the running total is not lost to a subshell.
    if [ -d "$abs" ]; then
        listing=$("$CTL" pending "$rel" 2>&1) || true
        case "$listing" in
            error:*)
                problems="${problems}${abs}
    pinned, but could not list its contents: ${listing}
"
                continue
                ;;
        esac
        # An empty listing is a valid answer: nothing dehydrated to pull
        # down. Counted in pure shell, not `wc -l`, which would miscount an
        # empty listing as 1 (and the packaging test bans content-reader
        # commands in command position anyway).
        total=0
        _oifs=$IFS
        IFS='
'
        for _c in $listing; do
            [ -n "$_c" ] && total=$((total + 1))
        done
        IFS=$_oifs
        done_n=0
        if [ "$total" -gt 0 ]; then
            # Announce the coming reads, so the daemon fetches and verifies
            # the content on parallel connections while the loop below pulls
            # the files one at a time. Purely advisory — a daemon without the
            # verb answers "unknown command:" and the loop is exactly as fast
            # as it was before the verb existed — so the reply is discarded.
            "$CTL" prefetch "$rel" >/dev/null 2>&1 || true
            progress_start "$total" \
                "Downloading $total $(files_word "$total") from \"$(basename -- "$abs")\"…"
        fi
        while IFS= read -r childrel; do
            [ -n "$childrel" ] || continue
            reply=$(hydrate_with_busy_retry "$MOUNT/$childrel")
            case "$reply" in
                "hydrated "*" bytes")
                    n=${reply#hydrated }
                    n=${n% bytes}
                    case "$n" in
                        '' | *[!0-9]*) n=0 ;;
                    esac
                    pulled=$((pulled + n))
                    # Only count a file as "pulled" if bytes actually came
                    # down; a 0-byte hydrate means it was already resident.
                    [ "$n" -gt 0 ] && pulled_files=$((pulled_files + 1))
                    ;;
                *)
                    problems="${problems}${MOUNT}/${childrel}
    ${reply}
"
                    ;;
            esac
            done_n=$((done_n + 1))
            progress_set "$done_n" \
                "Downloading $done_n of $total — $(basename -- "$childrel")"
            # Stop if the user closed the dialog. The folder stays pinned and
            # the files already counted stay resident; break, don't exit, so
            # the normal summary still runs and reports what came down.
            if progress_cancelled; then
                break
            fi
        done <<EOF
$listing
EOF
        progress_done
        continue
    fi

    # A file: hydrate it directly, by absolute path, so the ctl binary opens
    # exactly the file named.
    reply=$(hydrate_with_busy_retry "$abs")
    case "$reply" in
        "hydrated "*" bytes")
            n=${reply#hydrated }
            n=${n% bytes}
            case "$n" in
                '' | *[!0-9]*) n=0 ;;
            esac
            pulled=$((pulled + n))
            [ "$n" -gt 0 ] && pulled_files=$((pulled_files + 1))
            ;;
        *)
            # Pinned but not pulled: the file is kept from eviction, but its
            # content did not come down. Say so rather than claim success.
            problems="${problems}${abs}
    pinned, but not pulled down: ${reply}
"
            ;;
    esac
done

if [ -z "$problems" ]; then
    say ok "Kept $kept $(items_word "$kept") on device — $(pull_summary)."
else
    done_part=''
    if [ "$kept" -gt 0 ]; then
        done_part="Kept $kept $(items_word "$kept") on device — $(pull_summary).

"
    fi
    say problem "${done_part}These were not kept on device:

${problems}"
fi
