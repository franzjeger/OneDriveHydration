# GNOME Files context-menu entries for OneDrive Hydration: "Free Up Space"
# and "Keep on Device" directly in the right-click menu, not under Scripts.
#
# This is the one Nautilus surface that cannot be data: top-level menu items
# require a MenuProvider extension, which requires nautilus-python — the same
# trade nautilus-dropbox makes, and the reason the Scripts install exists as
# the dependency-free fallback. The extension is deliberately a *menu
# provider and nothing else*: every action is one Popen of the same generated
# wrapper the Scripts menu runs, so the daemon-protocol knowledge stays in
# exactly one place and the packaging tests keep pinning it there.
#
# Unlike Scripts (which Nautilus offers on every selection on the system),
# a MenuProvider sees the selection before the menu is built — so these
# entries appear ONLY for selections wholly inside the sync root, and never
# for the sync root itself. The wrappers keep their own containment checks
# anyway: the menu filtering is a courtesy, the wrapper refusal is the rule.
#
# Generated by install-nautilus-scripts.sh, which substitutes the sync root
# and the wrapper paths.

import subprocess

import gi

for _version in ("4.1", "4.0"):
    try:
        gi.require_version("Nautilus", _version)
        break
    except ValueError:
        continue
from gi.repository import GObject, Nautilus

MOUNT = "@MOUNT@"
FREE_UP_SPACE = "@FREE@"
KEEP_ON_DEVICE = "@KEEP@"


class OneDriveHydrationMenu(GObject.GObject, Nautilus.MenuProvider):
    def _selection_paths(self, files):
        """The selection as local paths, or [] when the menu must not appear.

        All-or-nothing on purpose: a mixed selection (half inside the sync
        root, half outside) gets no entry rather than an entry that would
        act on half of what the user selected.
        """
        paths = []
        for f in files:
            if f.get_uri_scheme() != "file":
                return []
            location = f.get_location()
            path = location.get_path() if location is not None else None
            if path is None:
                return []
            if path == MOUNT:
                # The sync folder itself is not a file in it.
                return []
            if not path.startswith(MOUNT + "/"):
                return []
            paths.append(path)
        return paths

    @staticmethod
    def _run(wrapper, paths):
        # Detached, exactly as Nautilus runs a script: the wrapper owns its
        # own reporting (notify-send / zenity), so nothing is waited for and
        # nothing is captured here.
        subprocess.Popen([wrapper] + paths)

    def get_file_items(self, *args):
        # Nautilus 4.x passes (files); 3.x passed (window, files). Taking the
        # last argument serves both without version-branching the signature.
        files = args[-1]
        paths = self._selection_paths(files)
        if not paths:
            return []

        free = Nautilus.MenuItem(
            name="OneDriveHydration::free_up_space",
            label="Free Up Space",
            tip="Return the selection to cloud-only placeholders",
        )
        free.connect("activate", lambda _item: self._run(FREE_UP_SPACE, paths))
        keep = Nautilus.MenuItem(
            name="OneDriveHydration::keep_on_device",
            label="Keep on Device",
            tip="Pin the selection and download its content now",
        )
        keep.connect("activate", lambda _item: self._run(KEEP_ON_DEVICE, paths))
        return [free, keep]
