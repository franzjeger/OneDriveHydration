[Desktop Entry]
Type=Service
# The folder half of Keep on Device, kept a *separate* entry from the file one so
# that only Keep on Device reaches a directory — Free Up Space stays file-only,
# because the daemon offers no bulk evict.
#
# Measured on this KIO build with probes/servicemenu-match.cpp (plasmashell
# 6.7.4, KIO 6.28), not taken from documentation. Against a control that returned
# no actions, an inode/directory entry:
#   * appears for a directory,
#   * does NOT appear for a regular file (so it never doubles the file entry),
#   * survives a multi-directory selection, so Exec=... %F and the wrapper's loop
#     are honest,
#   * disappears entirely for a mixed file+directory selection — so a mixed
#     selection offers nothing rather than the wrong thing, exactly as the
#     all/allfiles file entry does for its mirror case.
MimeType=inode/directory;
# TopLevel (read from this [Desktop Entry] group, not the action groups): kio
# buckets priority-less services into the "Actions" submenu, which buries these
# two. TopLevel lifts them to the top of the context menu, where a OneDrive
# user expects "Free Up Space" / "Keep on Device" to be.
X-KDE-Priority=TopLevel
Actions=onedriveHydrationFreeUpSpace;onedriveHydrationKeepOnDevice;

[Desktop Action onedriveHydrationFreeUpSpace]
Name=Free Up Space
Icon=onedrive-hydration
Exec=@ACTION3@ %F

[Desktop Action onedriveHydrationKeepOnDevice]
Name=Keep on Device
Icon=onedrive-hydration
Exec=@ACTION2@ %F
