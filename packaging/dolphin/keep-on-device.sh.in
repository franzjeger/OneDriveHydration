#!/bin/sh
# Dolphin's "Keep on Device" action: pin the selected files so eviction skips
# them, then pull their content down now. The inverse of "Free Up Space", and
# generated by install-servicemenu.sh the same way — it substitutes the sync
# root and the control CLI's absolute path, because this action has no
# configuration file and no session to read one from.
set -u

MOUNT='@MOUNT@'
CTL='@CTL@'
TITLE='OneDrive Hydration'

# Dolphin spawns this with a minimal environment. kdialog and notify-send
# need the session bus and runtime dir to work, so restore them.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

human() {
    # iec-i, not iec: the daemon counts bytes, and `--to=iec` would render
    # 8192 as "8.0KB" — a decimal-looking label on a binary quantity.
    if command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec-i --suffix=B -- "$1"
    else
        printf '%s bytes' "$1"
    fi
}

files_word() {
    if [ "$1" -eq 1 ]; then printf 'file'; else printf 'files'; fi
}

# Seconds -> "Hh MMm" / "MMm SSs" / "SSs", for the ETA in the progress label.
# Integer shell math only: the whole point is a number a person can read at a
# glance, and the per-file latency (~300ms) dwarfs the sub-second remainder.
fmt_dur() {
    _s=$1
    if [ "$_s" -ge 3600 ]; then
        printf '%dh %02dm' $((_s/3600)) $(((_s%3600)/60))
    elif [ "$_s" -ge 60 ]; then
        printf '%dm %02ds' $((_s/60)) $((_s%60))
    else
        printf '%ds' "$_s"
    fi
}

# "item" not "file": a Keep on Device target can be a folder, and calling a
# pinned folder "1 file" is the confusing report this wording replaces.
items_word() {
    if [ "$1" -eq 1 ]; then printf 'item'; else printf 'items'; fi
}

# Percent-encode a path for a file:// URL. LC_ALL=C so `?` matches one BYTE, and
# every non-unreserved byte is encoded — correct for UTF-8 filenames.
urlencode() {
    _s=$1
    _o=''
    _old=${LC_ALL:-}
    LC_ALL=C
    while [ -n "$_s" ]; do
        _c=${_s%"${_s#?}"}
        case $_c in
            [a-zA-Z0-9._~/-]) _o="$_o$_c" ;;
            *) _o="$_o$(printf '%%%02X' "'$_c")" ;;
        esac
        _s=${_s#?}
    done
    LC_ALL=$_old
    printf '%s' "$_o"
}

# Announce a residency change so the overlay plugin repaints the badge now. The
# plugin LISTENS for org.kde.KDirNotify.FilesChanged and pushes a fresh badge via
# KOverlayIconPlugin::overlaysChanged, which repaints regardless of stat — the one
# refresh that survives an eviction (its sibling Free Up Space leaves size and
# mtime unchanged), so both wrappers announce changes the same way. FilesChanged
# takes a QStringList.
refresh_overlay() {
    command -v dbus-send >/dev/null 2>&1 || return 0
    dbus-send --session --type=signal /org/kde/KDirNotify \
        org.kde.KDirNotify.FilesChanged "array:string:file://$(urlencode "$1")" \
        >/dev/null 2>&1 || true
}

# A progress dialog for a folder pull — which can be hundreds of files and take a
# while, and until now gave no sign it was working (the daemon's "downloading N"
# is sampled once a second and misses fast per-file pulls, so the tray shows
# nothing). kdialog --progressbar prints "service /path" and is driven over D-Bus;
# guarded so the action still runs headless (no kdialog or qdbus) with every call
# a no-op. The dialog is advisory — it has no cancel and closing it does not stop
# the pull — and it auto-closes on reaching the total. qdbus_bin is resolved once;
# $prog_ref and it are left UNQUOTED on purpose so "service /path" splits into the
# two arguments qdbus expects.
qdbus_bin=$(command -v qdbus6 || command -v qdbus || true)

progress_start() { # $1=total  $2=label
    prog_ref=''
    { [ -n "$qdbus_bin" ] && command -v kdialog >/dev/null 2>&1; } || return 0
    prog_ref=$(kdialog --title "$TITLE" --progressbar "$2" "$1" 2>/dev/null) || prog_ref=''
    [ -n "$prog_ref" ] && $qdbus_bin $prog_ref setAutoClose true >/dev/null 2>&1
    return 0
}

progress_set() { # $1=value  $2=label
    [ -n "${prog_ref:-}" ] || return 0
    $qdbus_bin $prog_ref Set "" value "$1" >/dev/null 2>&1
    $qdbus_bin $prog_ref setLabelText "$2" >/dev/null 2>&1
    return 0
}

progress_done() {
    [ -n "${prog_ref:-}" ] || return 0
    $qdbus_bin $prog_ref close >/dev/null 2>&1
    prog_ref=''
    return 0
}

# True once the user presses the dialog's Cancel button. kdialog shows that
# button on a progressbar by default; without this check it would sit there doing
# nothing while the pull ran on, so the loop polls it and stops. Stopping leaves
# the folder pinned and whatever came down already resident — a valid state, and
# the summary reports exactly how many files were pulled before the stop.
progress_cancelled() {
    [ -n "${prog_ref:-}" ] || return 1
    [ "$($qdbus_bin $prog_ref wasCancelled 2>/dev/null)" = "true" ]
}

# The download half of the result line: how many files came down, or that
# there was nothing to pull. Kept separate so "kept N on device" never implies
# a download that did not happen (the 0B-pulled confusion).
pull_summary() {
    if [ "$pulled_files" -gt 0 ]; then
        printf 'pulled %s %s down (%s)' "$pulled_files" "$(files_word "$pulled_files")" "$(human "$pulled")"
    else
        printf 'already on device'
    fi
}

# Dolphin runs this detached with no terminal, so anything printed to stdout is
# gone. Success is a passive popup nobody has to dismiss; a refusal is modal,
# because the whole point of quoting the daemon verbatim is that somebody reads
# it. Falling back through notify-send to stderr keeps the action working on a
# desktop without kdialog, where stderr at least reaches the journal.
say() {
    urgency=$1
    body=$2
    if command -v kdialog >/dev/null 2>&1; then
        if [ "$urgency" = ok ]; then
            kdialog --title "$TITLE" --passivepopup "$body" 7 >/dev/null 2>&1 && return 0
        else
            kdialog --title "$TITLE" --sorry "$body" >/dev/null 2>&1 && return 0
        fi
    fi
    if command -v notify-send >/dev/null 2>&1; then
        if [ "$urgency" = ok ]; then
            notify-send -a "$TITLE" -i onedrive-hydration "$TITLE" "$body" >/dev/null 2>&1 && return 0
        else
            notify-send -u critical -a "$TITLE" -i onedrive-hydration "$TITLE" "$body" >/dev/null 2>&1 && return 0
        fi
    fi
    printf '%s\n' "$body" >&2
}

[ "$#" -gt 0 ] || exit 0

kept=0          # items pinned (files and folders)
pulled=0        # bytes brought resident
pulled_files=0  # files whose content actually came down
problems=''

for f in "$@"; do
    # readlink -f normalises and resolves symlinks. It is a path operation and
    # reads no content — the same care Free Up Space takes, for the mirror-image
    # reason: the deliberate read that hydrates the file happens *inside*
    # onedrive-hydrationctl, never in this shell. Nothing below opens the target.
    abs=$(readlink -f -- "$f" 2>/dev/null) || abs=$f

    # KIO cannot restrict a servicemenu entry by path (measured: MimeType is the
    # only filter), so this entry appears on every file on the system and the
    # containment has to live here.
    case "$abs" in
        "$MOUNT")
            problems="${problems}${abs}
    that is the sync folder itself, not a file in it
"
            continue
            ;;
        "$MOUNT"/*)
            rel=${abs#"$MOUNT"/}
            ;;
        *)
            problems="${problems}${abs}
    not inside the sync folder ($MOUNT) — nothing was done
"
            continue
            ;;
    esac

    # Pin first: it is the durable half, and the one that outlives a reboot or a
    # future eviction sweep. If the daemon refuses the pin, do not go on to pull
    # content down under a promise it would not keep.
    reply=$("$CTL" pin "$rel" 2>&1) || true
    case "$reply" in
        pinned)
            kept=$((kept + 1))
            ;;
        *)
            # Quoted verbatim, refusal and failure alike — the pin verb answers
            # `error: <why>` for a path it will not take.
            problems="${problems}${abs}
    ${reply}
"
            continue
            ;;
    esac

    # A directory is pinned as a single mark — it protects its whole subtree —
    # and its dehydrated files are pulled down one at a time. The daemon lists
    # them with its own judgment (confinement, and skipping the framework's own
    # names), and each is hydrated here; the reads stay inside
    # onedrive-hydrationctl, never in this shell. Fed by a here-doc rather than a
    # pipe, so the running total is not lost to a subshell.
    if [ -d "$abs" ]; then
        listing=$("$CTL" pending "$rel" 2>&1) || true
        case "$listing" in
            error:*)
                problems="${problems}${abs}
    pinned, but could not list its contents: ${listing}
"
                continue
                ;;
        esac
        # An empty listing is a valid answer: nothing dehydrated to pull down.
        # Count first, so the dialog can show "N of TOTAL". Counted in pure shell,
        # not `grep -c`/`wc -l`: the packaging test bans content-reader commands in
        # command position (and a count is not a read of the target anyway), and a
        # bare `wc -l` would miscount an empty listing as 1. Newline-split with
        # empty fields dropped, so an empty listing counts 0 and no dialog appears.
        total=0
        _oifs=$IFS
        IFS='
'
        for _c in $listing; do
            [ -n "$_c" ] && total=$((total + 1))
        done
        IFS=$_oifs
        done_n=0
        # t0 anchors the speed/ETA: seconds since the pull began. date +%s is
        # whole seconds — fine, because the per-file latency (~300ms) dominates
        # and we only ever render "N/s" and a rounded ETA, never sub-second.
        t0=$(date +%s)
        if [ "$total" -gt 0 ]; then
            progress_start "$total" \
                "Downloading $total $(files_word "$total") from \"$(basename -- "$abs")\"…"
        fi
        while IFS= read -r childrel; do
            [ -n "$childrel" ] || continue
            reply=$("$CTL" hydrate "$MOUNT/$childrel" 2>&1) || true
            case "$reply" in
                "hydrated "*" bytes")
                    n=${reply#hydrated }
                    n=${n% bytes}
                    case "$n" in
                        '' | *[!0-9]*) n=0 ;;
                    esac
                    pulled=$((pulled + n))
                    # Only count a file as "pulled" if bytes actually came down;
                    # a 0-byte hydrate means it was already resident.
                    [ "$n" -gt 0 ] && pulled_files=$((pulled_files + 1))
                    ;;
                *)
                    problems="${problems}${MOUNT}/${childrel}
    ${reply}
"
                    ;;
            esac
            refresh_overlay "$MOUNT/$childrel"
            done_n=$((done_n + 1))
            # Speed + ETA from the elapsed wall-clock. Guarded on elapsed>=1 so the
            # first iteration (t0 just set) never divides by zero or shows a
            # misleading 0/s; from then on both are a stable, glanceable number.
            now=$(date +%s)
            elapsed=$((now - t0))
            if [ "$elapsed" -ge 1 ]; then
                rate=$(( (done_n + elapsed/2) / elapsed ))   # round to nearest
                [ "$rate" -lt 1 ] && rate=1
                eta=$(( (total - done_n + rate/2) / rate ))
                progress_set "$done_n" \
                    "Downloading $done_n of $total — $(basename -- "$childrel")  ·  ${rate} files/s  ·  ~$(fmt_dur "$eta") left"
            else
                progress_set "$done_n" \
                    "Downloading $done_n of $total — $(basename -- "$childrel")"
            fi
            # Stop if the user pressed Cancel. The folder stays pinned and the
            # $pulled_files already counted stay resident; break, don't exit, so the
            # normal summary still runs and reports what came down.
            if progress_cancelled; then
                break
            fi
        done <<EOF
$listing
EOF
        progress_done
        # A pinned folder is itself resident (a directory), so it never carries a
        # cloud emblem; its children's emblems are what changed, refreshed above.
        continue
    fi

    # A file: hydrate it directly, by absolute path, so the ctl binary opens
    # exactly the file named.
    reply=$("$CTL" hydrate "$abs" 2>&1) || true
    case "$reply" in
        "hydrated "*" bytes")
            n=${reply#hydrated }
            n=${n% bytes}
            case "$n" in
                '' | *[!0-9]*) n=0 ;;
            esac
            pulled=$((pulled + n))
            [ "$n" -gt 0 ] && pulled_files=$((pulled_files + 1))
            ;;
        *)
            # Pinned but not pulled: the file is kept from eviction, but its
            # content did not come down. Say so rather than claim success.
            problems="${problems}${abs}
    pinned, but not pulled down: ${reply}
"
            ;;
    esac
    # The file's residency moved (cloud-only -> on device), so its emblem is
    # re-queried and the cloud badge clears.
    refresh_overlay "$abs"
done

if [ -z "$problems" ]; then
    say ok "Kept $kept $(items_word "$kept") on device — $(pull_summary)."
else
    done_part=''
    if [ "$kept" -gt 0 ]; then
        done_part="Kept $kept $(items_word "$kept") on device — $(pull_summary).

"
    fi
    say problem "${done_part}These were not kept on device:

${problems}"
fi
