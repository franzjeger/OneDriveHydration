[Desktop Entry]
Type=Service
# Measured on this KIO build with probes/servicemenu-match.cpp, not taken from
# documentation — nothing installed on the machine used all/allfiles, so it was
# an assumption until the probe ran. Against a control that returned no actions
# at all, an all/allfiles entry:
#   * appears for a regular file of any mimetype (measured on text/plain),
#   * does NOT appear for a directory — which is what is wanted, because the
#     daemon's evict verb takes a file and there is no bulk-evict to offer,
#   * survives a multi-file selection, so Exec=... %F below is honest,
#   * disappears entirely for a mixed file+directory selection, so a mixed
#     selection silently offers nothing rather than the wrong thing.
MimeType=all/allfiles;
# TopLevel (read from this [Desktop Entry] group, not the action groups): kio
# buckets priority-less services into the "Actions" submenu, which buries these
# two. TopLevel lifts them to the top of the context menu, where a OneDrive
# user expects "Free Up Space" / "Keep on Device" to be.
X-KDE-Priority=TopLevel
Actions=onedriveHydrationFreeUpSpace;onedriveHydrationKeepOnDevice;

[Desktop Action onedriveHydrationFreeUpSpace]
# No ellipsis, deliberately, and this is the one place the wording differs from
# the flyout's "Free Up Space…". There the ellipsis is honest because a file
# picker opens first; here Dolphin has already chosen the files and the action
# runs immediately.
Name=Free Up Space
# The application icon, which packaging/icons/install-icons.sh installs. Using
# a stock KDE icon would be cheaper but would not say whose action this is, and
# inventing a new asset would need the provenance note that packaging/icons/
# requires of every ported image.
Icon=onedrive-hydration
# %F is every selected file as an absolute local path. The wrapper makes each
# one relative to the sync root, because that is what the control socket's
# evict verb takes — and it is the wrapper, not this file, that knows where the
# sync root is: KIO has no way to restrict an entry by path.
Exec=@ACTION@ %F

[Desktop Action onedriveHydrationKeepOnDevice]
# The inverse of Free Up Space: pin the selected files so eviction skips them,
# and pull their content down now. This is the *file* case (MimeType above);
# the directory case lives in servicemenu-folder.desktop.in as its own entry,
# so that only Keep on Device — not Free Up Space — reaches a folder. Both point
# at the same wrapper.
Name=Keep on Device
Icon=onedrive-hydration
# A second wrapper, substituted to its own absolute path by the installer. Same
# %F contract: the wrapper computes the relative path for `pin` and hands the
# absolute path to `hydrate`, which reads it — the wrapper itself never does.
Exec=@ACTION2@ %F
