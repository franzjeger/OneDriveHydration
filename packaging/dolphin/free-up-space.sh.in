#!/bin/sh
# Dolphin's "Free Up Space" action: evict the selected files back to
# placeholders. Generated by install-servicemenu.sh, which substitutes the
# sync root and the control CLI's absolute path — the same reason the systemd
# installer generates concrete units rather than shipping generic ones: this
# action has no configuration file and no session to read one from, and a
# wrapper that guessed either fact would guess it silently.
set -u

MOUNT='@MOUNT@'
CTL='@CTL@'
TITLE='OneDrive Hydration'

human() {
    # iec-i, not iec: the daemon counts bytes, and `--to=iec` would render
    # 8192 as "8.0KB" — a decimal-looking label on a binary quantity.
    if command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec-i --suffix=B -- "$1"
    else
        printf '%s bytes' "$1"
    fi
}

files_word() {
    if [ "$1" -eq 1 ]; then printf 'file'; else printf 'files'; fi
}

# Dolphin runs this detached with no terminal, so anything printed to stdout is
# gone. Success is a passive popup nobody has to dismiss; a refusal is modal,
# because the whole point of quoting the daemon verbatim is that somebody reads
# it. Falling back through notify-send to stderr keeps the action working on a
# desktop without kdialog, where stderr at least reaches the journal.
say() {
    urgency=$1
    body=$2
    if command -v kdialog >/dev/null 2>&1; then
        if [ "$urgency" = ok ]; then
            kdialog --title "$TITLE" --passivepopup "$body" 7 >/dev/null 2>&1 && return 0
        else
            kdialog --title "$TITLE" --sorry "$body" >/dev/null 2>&1 && return 0
        fi
    fi
    if command -v notify-send >/dev/null 2>&1; then
        if [ "$urgency" = ok ]; then
            notify-send -a "$TITLE" -i onedrive-hydration "$TITLE" "$body" >/dev/null 2>&1 && return 0
        else
            notify-send -u critical -a "$TITLE" -i onedrive-hydration "$TITLE" "$body" >/dev/null 2>&1 && return 0
        fi
    fi
    printf '%s\n' "$body" >&2
}

[ "$#" -gt 0 ] || exit 0

freed=0
ok=0
problems=''

for f in "$@"; do
    # readlink -f normalises and resolves symlinks. It is a path operation and
    # reads no content, which matters more here than it looks: on this mount a
    # read is what hydrates a placeholder, so a wrapper that ran `file`, `head`
    # or `cat` on its argument would fill the very file the user asked to
    # empty. Nothing below ever opens the target.
    abs=$(readlink -f -- "$f" 2>/dev/null) || abs=$f

    # KIO cannot restrict a servicemenu entry by path (measured: MimeType is
    # the only filter, and there is no path condition), so this entry appears
    # on every file on the system and the check has to live here.
    case "$abs" in
        "$MOUNT")
            problems="${problems}${abs}
    that is the sync folder itself, not a file in it
"
            continue
            ;;
        "$MOUNT"/*)
            rel=${abs#"$MOUNT"/}
            ;;
        *)
            problems="${problems}${abs}
    not inside the sync folder ($MOUNT) — nothing was done
"
            continue
            ;;
    esac

    reply=$("$CTL" evict "$rel" 2>&1) || true

    # Free Up Space is the inverse of Keep on Device, so a file the user kept and
    # now asks to free is un-kept: a DIRECTLY pinned file is unpinned and evicted
    # again — the way "Free up space" clears "Always keep on this device" on
    # Windows. A file pinned through an ANCESTOR folder is left alone: unpinning
    # the file would not help (the folder's pin still protects it) and silently
    # un-keeping the whole folder is not what was asked, so its refusal is shown
    # verbatim and names the folder to free instead. The `via` path the daemon
    # reports is read from the reply string, never from the file — no content is
    # opened here.
    case "$reply" in
        *'Pinned { via:'*)
            via=$(printf '%s' "$reply" | sed -n 's/.*via: "\(.*\)".*/\1/p')
            if [ "$via" = "$abs" ]; then
                "$CTL" unpin "$rel" >/dev/null 2>&1 || true
                reply=$("$CTL" evict "$rel" 2>&1) || true
            fi
            ;;
    esac

    case "$reply" in
        "reclaimed "*" bytes")
            n=${reply#reclaimed }
            n=${n% bytes}
            case "$n" in
                '' | *[!0-9]*) n=0 ;;
            esac
            freed=$((freed + n))
            ok=$((ok + 1))
            ;;
        *)
            # Every other answer is quoted verbatim, refusal and failure alike,
            # the way the flyout quotes Error.Kept rather than flattening it.
            #
            # The exit status cannot be used to tell those apart, or even to
            # notice them: onedrive-hydrationctl exits 1 only for `error:` and
            # `unknown command:`, so a `kept:` refusal exits 0. A wrapper that
            # trusted $? would count a kept file as freed while the daemon was
            # explaining why it had not touched it.
            problems="${problems}${abs}
    ${reply}
"
            ;;
    esac
done

if [ -z "$problems" ]; then
    say ok "Freed $(human "$freed") from $ok $(files_word "$ok")."
else
    done_part=''
    if [ "$ok" -gt 0 ]; then
        done_part="Freed $(human "$freed") from $ok $(files_word "$ok").

"
    fi
    # "These were not freed" and nothing more. An earlier draft said "in the
    # daemon's own words", which was true of the kept:/error: lines and false
    # of the two refusals this script writes itself — a claim about provenance
    # that was wrong for half the list it introduced.
    say problem "${done_part}These were not freed:

${problems}"
fi
